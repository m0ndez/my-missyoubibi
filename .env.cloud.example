# Settings and secrets for docker-compose.cloud.yml. Copy to .env.cloud (git-ignored), then `chmod 600 .env.cloud`. The home bridge's compose file holds only MQTT_DEVICE_PASS.
BROKER_HOST=mqtt.example.com     # DNS-only A record (grey cloud) pointing at the VPS: Cloudflare's proxy cannot carry 8883
ACME_EMAIL=you@example.com
CLOUDFLARE_API_TOKEN=            # one zone, Zone > DNS > Edit (DNS Write) only. Whether certbot also needs Zone > Zone > Read is unconfirmed: run once with ACME_STAGING=1 and add it, and record that here, only if certbot fails with a zone lookup error
# ACME_STAGING=1                 # test issuance and renewal without Let's Encrypt rate limits (the certificate is untrusted)
MQTT_PASS=                       # broker password of the "app" user (openssl rand -hex 24)
MQTT_DEVICE_PASS=                # broker password of the "device" user (the bridge)
