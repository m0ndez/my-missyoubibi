# `npm run setup` creates .env for you (secrets, network detection) and starts the stack. This lists what it writes.
APP_PASSWORD=          # the login password
AUTH_SECRET=           # signs session cookies (openssl rand -hex 32)
MQTT_PASS=             # broker password of the "app" user
MQTT_DEVICE_PASS=      # broker password of the "device" user (the bridge)
WFRAC_SUBNET=          # the LAN the bridge scans for adapters, e.g. 192.168.1.0/24 (detected by setup)
MQTT_URL=mqtt://localhost:1883   # for `npm run dev`; MQTT_USER=app and MQTT_PASS above are used with it
MQTT_USER=app
# APP_BIND=0.0.0.0     # `npm run setup` asks. 127.0.0.1: this computer only (use `tailscale serve`); 0.0.0.0: phones on your Wi-Fi, over plain HTTP
# MQTT_BIND=0.0.0.0    # default 127.0.0.1. Only needed to reach the broker from another machine (Home Assistant on its own host)
# MQTT_ALLOW_LAN=1      # required with a non-loopback MQTT_BIND: the broker is not encrypted
# ALLOWED_HOSTS=ac.example.com,*.home.example   # names the page is served under; private IPs, localhost, *.local and *.ts.net always work
# TZ=Europe/Berlin     # timers and daily energy totals (setup detects yours)
# WFRAC_DEVICES=bedroom=192.168.1.50   # optional fixed addresses (unit id=address) instead of finding units by MAC
# ALLOW_NO_AUTH=1                 # DANGEROUS: turns the login off for `npm run dev` (this computer only; `npm run dev:lan` opens it to your network). Ignored by the installed app.
# HA_DISCOVERY=1       # publish Home Assistant MQTT discovery for each device
# ENERGY_RATE=4.5                  # optional: price per kWh, shows an estimated cost in the Energy report
# ENERGY_CURRENCY=฿
