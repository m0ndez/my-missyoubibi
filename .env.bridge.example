# Settings for docker-compose.bridge.yml (the home side of the Cloud deployment). Copy to .env.bridge (git-ignored), then `chmod 600 .env.bridge`.
BROKER_HOST=mqtt.example.com     # the Broker's DNS-only name: the same BROKER_HOST as on the VPS
MQTT_DEVICE_PASS=                # the VPS's MQTT_DEVICE_PASS: the only secret this machine holds
WFRAC_SUBNET=192.168.1.0/24      # the home LAN the bridge scans for adapters
TZ=UTC                           # your timezone: the same as on the VPS
# WFRAC_DEVICES=bedroom=192.168.1.50   # optional fixed addresses (unit id=address) instead of finding units by MAC
# VERSION=latest                 # bridge image tag
